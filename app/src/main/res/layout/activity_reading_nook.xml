<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:colorBackground"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/nookToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?android:colorBackground"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="?android:textColorPrimary"
        app:title="@string/reading_nook_title"
        app:titleTextColor="?android:textColorPrimary" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="@dimen/spacing_xl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Book Hero Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/row_content_padding_h"
                android:layout_marginTop="@dimen/spacing_md"
                android:layout_marginEnd="@dimen/row_content_padding_h"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Cover + Info -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/nookCover"
                            android:layout_width="90dp"
                            android:layout_height="135dp"
                            android:background="@drawable/cover_frame"
                            android:contentDescription="@string/book_cover"
                            android:scaleType="centerCrop" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/nookTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="3"
                                android:textColor="?android:textColorPrimary"
                                android:textSize="@dimen/text_size_hero"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/nookAuthor"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:textColor="?attr/colorPrimary"
                                android:textSize="@dimen/text_size_body_small" />

                            <TextView
                                android:id="@+id/nookSeries"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textColor="?android:textColorSecondary"
                                android:textSize="@dimen/text_size_overline"
                                android:visibility="gone" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Status Selector -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="@string/nook_status"
                            android:textColor="?android:textColorSecondary"
                            android:textSize="@dimen/text_size_body_small"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/nookStatusGroup"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            app:singleSelection="true">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/nookStatusUnread"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/nook_status_unread"
                                android:textSize="@dimen/text_size_body_small" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/nookStatusReading"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/nook_status_reading"
                                android:textSize="@dimen/text_size_body_small" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/nookStatusFinished"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/nook_status_finished"
                                android:textSize="@dimen/text_size_body_small" />
                        </com.google.android.material.button.MaterialButtonToggleGroup>
                    </LinearLayout>

                    <!-- Progress -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="?attr/livreColorSurfaceVariant"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/nook_progress"
                                android:textColor="?android:textColorPrimary"
                                android:textSize="@dimen/text_size_body_small"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/nookProgressPercent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="?attr/colorPrimary"
                                android:textSize="@dimen/text_size_body_small"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/nookProgressBar"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:layout_marginTop="6dp"
                            android:progressTint="?attr/colorPrimary"
                            android:progressBackgroundTint="?attr/colorSurface" />

                        <TextView
                            android:id="@+id/nookCurrentLocation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="?android:textColorSecondary"
                            android:textSize="@dimen/text_size_overline"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Analytics snapshot -->
                    <LinearLayout
                        android:id="@+id/nookAnalytics"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/nookStampsCount"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:textColor="?android:textColorSecondary"
                            android:textSize="@dimen/text_size_overline" />

                        <TextView
                            android:id="@+id/nookJournalsCount"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:textColor="?android:textColorSecondary"
                            android:textSize="@dimen/text_size_overline" />

                        <TextView
                            android:id="@+id/nookHighlightsCount"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:textColor="?android:textColorSecondary"
                            android:textSize="@dimen/text_size_overline" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Tab Navigation -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/nookTabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/row_content_padding_h"
                android:layout_marginTop="@dimen/spacing_md"
                android:layout_marginEnd="@dimen/row_content_padding_h"
                app:tabIndicatorColor="?attr/colorPrimary"
                app:tabMode="scrollable"
                app:tabSelectedTextColor="?attr/colorPrimary"
                app:tabTextColor="?android:textColorSecondary" />

            <!-- Tab Content Containers -->
            <FrameLayout
                android:id="@+id/nookTabContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/row_content_padding_h"
                android:layout_marginTop="@dimen/spacing_sm"
                android:layout_marginEnd="@dimen/row_content_padding_h"
                android:layout_marginBottom="@dimen/spacing_xl" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
