<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="?android:colorBackground">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:title="@string/book_details_title"
            app:titleTextColor="?android:textColorPrimary"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="?android:textColorPrimary" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="?android:colorBackground"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/spacing_xl">

            <!-- Phase 10: Centered Hero Cover -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/row_content_padding_h"
                android:paddingTop="@dimen/spacing_md"
                android:paddingEnd="@dimen/row_content_padding_h">

                <ImageView
                    android:id="@+id/cover"
                    android:layout_width="180dp"
                    android:layout_height="270dp"
                    android:layout_gravity="center"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/book_cover"
                    android:scaleType="centerCrop" />
            </FrameLayout>

            <!-- Phase 10: Title (centered) -->
            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/row_content_padding_h"
                android:layout_marginTop="@dimen/spacing_md"
                android:layout_marginEnd="@dimen/row_content_padding_h"
                android:gravity="center"
                android:textColor="?android:textColorPrimary"
                android:textSize="@dimen/text_size_headline"
                android:textStyle="bold" />

            <!-- Phase 10: Author (smaller, accent color) -->
            <TextView
                android:id="@+id/authorValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/row_content_padding_h"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="@dimen/row_content_padding_h"
                android:gravity="center"
                android:textColor="?attr/colorPrimary"
                android:textSize="@dimen/text_size_body_medium" />

            <!-- Phase 10: Series (optional, secondary color) -->
            <TextView
                android:id="@+id/seriesValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/row_content_padding_h"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="@dimen/row_content_padding_h"
                android:gravity="center"
                android:textColor="?android:textColorSecondary"
                android:textSize="@dimen/text_size_overline"
                android:visibility="gone" />

            <!-- Phase 10: Progress Section -->
            <LinearLayout
                android:id="@+id/progressSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/row_content_padding_h"
                android:layout_marginTop="@dimen/spacing_md"
                android:layout_marginEnd="@dimen/row_content_padding_h"
                android:background="?attr/colorSurfaceVariant"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/details_reading_progress"
                        android:textColor="?android:textColorPrimary"
                        android:textSize="@dimen/text_size_body_small"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/progressPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="@dimen/text_size_body_small"
                        android:textStyle="bold" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="6dp"
                    android:progressTint="?attr/colorPrimary"
                    android:progressBackgroundTint="?attr/colorSurface" />

                <TextView
                    android:id="@+id/currentSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="?android:textColorSecondary"
                    android:textSize="@dimen/text_size_overline"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Phase 10: Action Buttons (icons + labels) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/row_content_padding_h"
                android:layout_marginTop="@dimen/spacing_md"
                android:layout_marginEnd="@dimen/row_content_padding_h"
                android:orientation="vertical">

                <!-- Primary: Resume/Start Reading -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRead"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/option_open"
                    app:icon="@drawable/ic_menu_book" />

                <!-- Secondary: Open Reading Nook -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReadingNook"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/details_open_nook"
                    app:icon="@drawable/ic_compass" />

                <!-- Row: Favorite + Add/Drop Reading -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFavorite"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/option_favorite"
                        app:icon="@drawable/ic_favorite_border" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRemoveReading"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/option_add_reading"
                        app:icon="@drawable/ic_bookmark_border" />
                </LinearLayout>

                <!-- Row: Edit Metadata + Delete -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEditDetails"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/option_edit_details"
                        app:icon="@drawable/ic_edit" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRemove"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/option_remove"
                        android:textColor="?attr/colorError"
                        app:icon="@drawable/ic_delete"
                        app:iconTint="?attr/colorError" />
                </LinearLayout>
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginStart="@dimen/row_content_padding_h"
                android:layout_marginTop="@dimen/spacing_lg"
                android:layout_marginEnd="@dimen/row_content_padding_h"
                android:background="?attr/livreColorDivider" />

            <!-- Phase 10: Synopsis -->
            <LinearLayout
                android:id="@+id/descriptionContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/row_content_padding_h"
                android:layout_marginTop="@dimen/spacing_sm"
                android:layout_marginEnd="@dimen/row_content_padding_h"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/descriptionLabel"
                    style="@style/ReaderSettingLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="@string/book_synopsis" />

                <TextView
                    android:id="@+id/description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="?android:textColorPrimary"
                    android:textSize="@dimen/text_size_body_medium" />
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginStart="@dimen/row_content_padding_h"
                android:layout_marginTop="@dimen/spacing_lg"
                android:layout_marginEnd="@dimen/row_content_padding_h"
                android:background="?attr/livreColorDivider" />

            <!-- Phase 10: Metadata Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/row_content_padding_h"
                android:layout_marginTop="@dimen/spacing_sm"
                android:layout_marginEnd="@dimen/row_content_padding_h"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/bookAuthorLabel"
                    style="@style/ReaderSettingLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="@string/book_author" />

                <TextView
                    android:id="@+id/bookValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="?android:textColorPrimary"
                    android:textSize="@dimen/text_size_body_medium" />

                <LinearLayout
                    android:id="@+id/seriesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/bookSeriesLabel"
                        style="@style/ReaderSettingLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:text="@string/book_series" />

                    <TextView
                        android:id="@+id/seriesMetadataValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="?android:textColorPrimary"
                        android:textSize="@dimen/text_size_body_medium" />
                </LinearLayout>

                <TextView
                    android:id="@+id/bookFilenameLabel"
                    style="@style/ReaderSettingLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/book_filename" />

                <TextView
                    android:id="@+id/filenameValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="?android:textColorPrimary"
                    android:textSize="@dimen/text_size_body_medium" />

                <TextView
                    android:id="@+id/bookSizeLabel"
                    style="@style/ReaderSettingLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/book_size" />

                <TextView
                    android:id="@+id/filesizeValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="?android:textColorPrimary"
                    android:textSize="@dimen/text_size_body_medium" />

                <TextView
                    android:id="@+id/bookLanguageLabel"
                    style="@style/ReaderSettingLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/book_language" />

                <TextView
                    android:id="@+id/languageValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="?android:textColorPrimary"
                    android:textSize="@dimen/text_size_body_medium" />

                <TextView
                    android:id="@+id/publisherLabel"
                    style="@style/ReaderSettingLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/book_publisher" />

                <TextView
                    android:id="@+id/publisherValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="?android:textColorPrimary"
                    android:textSize="@dimen/text_size_body_medium" />

                <TextView
                    android:id="@+id/publishYearLabel"
                    style="@style/ReaderSettingLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/book_publish_year" />

                <TextView
                    android:id="@+id/publishYearValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="?android:textColorPrimary"
                    android:textSize="@dimen/text_size_body_medium" />

                <TextView
                    android:id="@+id/subjectsLabel"
                    style="@style/ReaderSettingLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/book_subjects" />

                <TextView
                    android:id="@+id/subjectsValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="?android:textColorPrimary"
                    android:textSize="@dimen/text_size_body_medium" />

                <TextView
                    android:id="@+id/bookAddedLabel"
                    style="@style/ReaderSettingLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/book_added" />

                <TextView
                    android:id="@+id/dateAddedValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="?android:textColorPrimary"
                    android:textSize="@dimen/text_size_body_medium" />

                <LinearLayout
                    android:id="@+id/lastReadContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/lastReadLabel"
                        style="@style/ReaderSettingLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:text="@string/book_last_read_and_bookmark" />

                    <TextView
                        android:id="@+id/lastReadValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="?android:textColorPrimary"
                        android:textSize="@dimen/text_size_body_medium" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
