<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:colorBackground"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/searchToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?android:colorBackground"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="?android:textColorPrimary"
        app:title="@string/search_results"
        app:titleTextColor="?android:textColorPrimary" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/row_content_padding_h"
        android:layout_marginTop="@dimen/row_padding_v"
        android:layout_marginEnd="@dimen/row_content_padding_h"
        android:layout_marginBottom="@dimen/row_padding_v"
        app:boxStrokeColor="?attr/colorPrimary"
        app:hintEnabled="false"
        app:startIconDrawable="@drawable/ic_search"
        app:startIconTint="?attr/colorSecondary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/searchEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:hint="@string/search_hint_books"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="?android:textColorPrimary"
            android:textColorHint="?android:textColorSecondary" />
    </com.google.android.material.textfield.TextInputLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/searchRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/grid_edge_h"
        android:paddingEnd="@dimen/grid_edge_h"
        android:paddingBottom="@dimen/spacing_xl"
        android:scrollbars="vertical" />

    <LinearLayout
        android:id="@+id/searchEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/spacing_xxl"
        android:visibility="gone">

        <TextView
            android:id="@+id/searchEmptyText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/empty_library"
            android:textColor="?android:textColorSecondary"
            android:textSize="@dimen/text_size_body_large" />
    </LinearLayout>
</LinearLayout>
