<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/nook_stamp_type"
        android:textColor="?android:textColorPrimary"
        android:textSize="@dimen/text_size_body_small"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/stampTypeSpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/nook_stamp_note"
        android:textColor="?android:textColorPrimary"
        android:textSize="@dimen/text_size_body_small"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/stampNoteField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/nook_stamp_note"
        android:inputType="textMultiLine"
        android:minLines="2" />
</LinearLayout>
