<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/grid_edge_h"
    android:layout_marginEnd="@dimen/grid_edge_h"
    android:layout_marginBottom="14dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="@dimen/thumbnail_corner_radius"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="6dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Kindle-style tall cover: height = 1.5 * width (portrait) -->
            <ImageView
                android:id="@+id/cover"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:background="@drawable/cover_frame"
                android:contentDescription="@string/book_author"
                android:scaleType="centerCrop"
                app:layout_constraintDimensionRatio="H,1:1.5"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Progress % badge, top-right corner of cover -->
            <TextView
                android:id="@+id/progressBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/badge_bg"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:textColor="?attr/livreColorSuccess"
                android:textSize="@dimen/text_size_cover_label"
                android:textStyle="bold"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="@id/cover"
                app:layout_constraintTop_toTopOf="@id/cover" />

            <!-- Thin progress bar along the bottom of the cover -->
            <View
                android:id="@+id/progressTrack"
                android:layout_width="0dp"
                android:layout_height="3dp"
                android:background="?attr/livreColorDisabled"
                app:layout_constraintBottom_toBottomOf="@id/cover"
                app:layout_constraintStart_toStartOf="@id/cover"
                app:layout_constraintEnd_toEndOf="@id/cover" />

            <View
                android:id="@+id/progressFill"
                android:layout_width="0dp"
                android:layout_height="3dp"
                android:background="?attr/livreColorSuccess"
                app:layout_constraintBottom_toBottomOf="@id/cover"
                app:layout_constraintStart_toStartOf="@id/cover"
                app:layout_constraintEnd_toEndOf="@id/progressTrack" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="?android:textColorPrimary"
            android:textSize="@dimen/text_size_overline"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/author"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?android:textColorSecondary"
            android:textSize="@dimen/text_size_caption" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
