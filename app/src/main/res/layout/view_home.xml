<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/homeScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:paddingBottom="@dimen/spacing_xl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/homeEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="280dp"
            android:layout_marginStart="@dimen/spacing_xxl"
            android:layout_marginTop="72dp"
            android:layout_marginEnd="@dimen/spacing_xxl"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:alpha="0.45"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_home" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/home_empty_title"
                android:textColor="?android:textColorPrimary"
                android:textSize="@dimen/text_size_hero"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/home_empty_hint"
                android:textColor="?android:textColorSecondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/homeEmptyAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/action_import_file" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/homeContinueSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/row_content_padding_h"
                android:layout_marginTop="26dp"
                android:layout_marginEnd="@dimen/row_content_padding_h"
                android:text="@string/home_continue_heading"
                android:textColor="?android:textColorPrimary"
                android:textSize="@dimen/text_size_title_large"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/homeContinueCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/row_content_padding_h"
                android:layout_marginTop="@dimen/spacing_md"
                android:layout_marginEnd="@dimen/row_content_padding_h"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="18dp">

                    <ImageView
                        android:id="@+id/homeContinueCover"
                        android:layout_width="94dp"
                        android:layout_height="141dp"
                        android:background="@drawable/cover_frame"
                        android:contentDescription="@string/book_cover"
                        android:scaleType="centerCrop" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/homeContinueTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="3"
                            android:textColor="?android:textColorPrimary"
                            android:textSize="@dimen/text_size_hero"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/homeContinueAuthor"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textColor="?android:textColorSecondary"
                            android:textSize="@dimen/text_size_body_small" />

                        <TextView
                            android:id="@+id/homeContinueSeries"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textColor="?android:textColorSecondary"
                            android:textSize="@dimen/text_size_overline" />

                        <TextView
                            android:id="@+id/homeContinueLocation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:textColor="?android:textColorSecondary"
                            android:textSize="@dimen/text_size_overline" />

                        <TextView
                            android:id="@+id/homeContinueProgress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="?android:textColorSecondary"
                            android:textSize="@dimen/text_size_overline" />

                        <ProgressBar
                            android:id="@+id/homeContinueProgressBar"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:layout_marginTop="6dp"
                            android:progressTint="?attr/colorPrimary"
                            android:progressBackgroundTint="?attr/livreColorSurfaceVariant" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/homeContinueResume"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/home_resume_reading"
                                android:textSize="@dimen/text_size_body_small" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/homeContinueDetails"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp"
                                android:text="@string/home_book_details"
                                android:textSize="@dimen/text_size_body_small" />
                        </LinearLayout>
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/homeContinueButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/continue_reading"
                        android:src="@drawable/ic_menu_book"
                        app:tint="?android:textColorPrimary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/homeRecentlyAddedSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/row_content_padding_h"
                android:layout_marginTop="30dp"
                android:layout_marginEnd="@dimen/row_content_padding_h"
                android:text="@string/home_recently_added"
                android:textColor="?android:textColorPrimary"
                android:textSize="@dimen/text_size_title"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/homeRecentlyAdded"
                android:layout_width="match_parent"
                android:layout_height="262dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:paddingStart="@dimen/row_content_padding_h"
                android:paddingEnd="@dimen/row_content_padding_h"
                android:paddingTop="10dp"
                android:paddingBottom="@dimen/spacing_sm" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/homeFavoritesSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="@dimen/row_content_padding_h"
                android:layout_marginTop="28dp"
                android:layout_marginEnd="@dimen/row_content_padding_h">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/home_favorites"
                    android:textColor="?android:textColorPrimary"
                    android:textSize="@dimen/text_size_title"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/homeFavoritesViewAll"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_view_all"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="@dimen/text_size_overline" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/homeFavorites"
                android:layout_width="match_parent"
                android:layout_height="262dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:paddingStart="@dimen/row_content_padding_h"
                android:paddingEnd="@dimen/row_content_padding_h"
                android:paddingTop="10dp"
                android:paddingBottom="@dimen/spacing_sm" />
        </LinearLayout>

        <!-- Phase 10: Authors navigation card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/homeAuthorsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/row_content_padding_h"
            android:layout_marginTop="28dp"
            android:layout_marginEnd="@dimen/row_content_padding_h"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/home_browse_authors"
                        android:textColor="?android:textColorPrimary"
                        android:textSize="@dimen/text_size_title"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/homeAllAuthors"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_all_authors"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="@dimen/text_size_overline" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/homeAuthorsNavContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Phase 10: Series navigation card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/homeSeriesCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/row_content_padding_h"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="@dimen/row_content_padding_h"
            android:layout_marginBottom="@dimen/spacing_xl"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/home_browse_series"
                        android:textColor="?android:textColorPrimary"
                        android:textSize="@dimen/text_size_title"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/homeAllSeries"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_all_series"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="@dimen/text_size_overline" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/homeSeriesNavContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
