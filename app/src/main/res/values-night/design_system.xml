<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      ============================================================
      NIGHT-QUALIFIED SEMANTIC COLOR TOKENS
      ============================================================
      These overrides are automatically selected by Android when the
      system is in dark mode (because the base Theme.Livre now extends
      Theme.MaterialComponents.DayNight). Only color tokens are
      overridden here — dimensions, shapes, typography, and component
      styles stay identical between day and night, so every layout
      renders with the same structure, spacing, and sizing in both
      modes. Only the color palette changes.

      Night mapping mirrors the original Livre Magicae dark theme:
        background  → eggplant (#3C2A4D)
        surface     → plum (#503A65)
        surface alt → purple (#574F7D)
        text primary → mint (#E0F0EA)
        text muted   → slate (#95ADBE)
        border       → purple (#574F7D)

      Reader chrome tokens are NOT overridden here — the reader chrome
      is always dark (eggplant/plum/white/mint) regardless of app
      day/night, exactly as the original app. Reader content area
      colors are controlled by ReaderThemes.kt, not by the app theme.
      ============================================================
    -->

    <!-- ===== Primary / Brand (unchanged in night) ===== -->
    <color name="colorPrimary">@color/palette_plum</color>
    <color name="colorPrimaryVariant">@color/palette_purple</color>
    <color name="colorOnPrimary">@color/white</color>
    <color name="colorSecondary">@color/palette_slate</color>
    <color name="colorOnSecondary">@color/white</color>

    <!-- ===== Background & Surfaces (night) ===== -->
    <color name="colorBackground">@color/dark_bg</color>
    <color name="colorSurface">@color/dark_surface</color>
    <color name="colorSurfaceVariant">@color/dark_surface_alt</color>
    <color name="colorOnBackground">@color/dark_text</color>
    <color name="colorOnSurface">@color/dark_text</color>

    <!-- ===== Text Hierarchy (night) ===== -->
    <color name="colorTextPrimary">@color/dark_text</color>
    <color name="colorTextSecondary">@color/dark_text_muted</color>
    <color name="colorTextTertiary">@color/dark_text_faint</color>

    <!-- ===== Structural (night) ===== -->
    <color name="colorDivider">@color/dark_border</color>
    <color name="colorAccent">@color/palette_mint</color>
    <color name="colorError">@color/palette_mint</color>
    <color name="colorSuccess">@color/palette_mint</color>
    <color name="colorDisabled">@color/dark_text_faint</color>

    <!-- ===== Reader Content Area (unchanged — controlled by ReaderThemes.kt) ===== -->
    <color name="colorReaderBackground">@color/reader_bg_light</color>
    <color name="colorReaderText">@color/reader_ink_light</color>
    <color name="colorReaderLink">@color/palette_purple</color>
    <color name="colorReaderSelection">@color/tts_word_highlight</color>

    <!-- ===== Reader Chrome (unchanged — always dark) ===== -->
    <color name="colorReaderChromeBackground">@color/reader_chrome_bg</color>
    <color name="colorReaderChromeSurface">@color/reader_chrome_surface</color>
    <color name="colorReaderChromeText">@color/reader_chrome_text</color>
    <color name="colorReaderChromeTextSecondary">@color/reader_chrome_text_muted</color>
    <color name="colorReaderChromeAccent">@color/reader_chrome_accent</color>
    <color name="colorReaderChromeScrim">@color/reader_chrome_scrim</color>
</resources>
