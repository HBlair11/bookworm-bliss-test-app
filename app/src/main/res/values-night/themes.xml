<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      ============================================================
      NIGHT OVERRIDE — intentionally empty (Phase 10)
      ============================================================
      The app now offers only two LIGHT app themes (Original and
      Pastel); the "Night" app theme has been removed. To stop the
      system dark-mode setting from re-skinning the app, the base
      Theme.Livre now extends Theme.MaterialComponents.Light (see
      values/themes.xml) and this night qualifier file no longer
      reassigns any colors. Leaving it empty guarantees the night
      config resolves identically to the default (light) config.

      The reader chrome is unaffected: it is always dark via
      Theme.Livre.Reader, which sets its own colors explicitly.
      ============================================================
    -->
</resources>
