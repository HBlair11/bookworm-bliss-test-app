<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      ============================================================
      TYPOGRAPHY — TEXT APPEARANCE STYLES
      ============================================================
      Every text element in the app should reference one of these
      styles instead of setting textSize / textColor / fontFamily
      individually. This gives us a single place to change the
      app's typography.

      Type scale:
        LivreText.Overline   12sp  bold  uppercase  secondary
        LivreText.Caption    11sp  normal           tertiary
        LivreText.BodySmall  13sp  normal           secondary
        LivreText.Body       14sp  normal           primary
        LivreText.BodyLarge  16sp  normal           primary
        LivreText.Title      18sp  bold             primary
        LivreText.TitleLarge 22sp  bold             primary
        LivreText.Headline   26sp  bold             primary

      All colors come from the semantic tokens in design_system.xml
      via the livre-prefixed custom attributes.
    -->

    <!-- Overline: small uppercase labels above content sections -->
    <style name="TextAppearance.Livre.Overline" parent="TextAppearance.MaterialComponents.Overline">
        <item name="android:textSize">@dimen/text_size_overline</item>
        <item name="android:textColor">?attr/livreColorTextSecondary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <!-- Caption: smallest body text, metadata, timestamps -->
    <style name="TextAppearance.Livre.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">@dimen/text_size_caption</item>
        <item name="android:textColor">?attr/livreColorTextTertiary</item>
    </style>

    <!-- Body Small: secondary information, subtitles -->
    <style name="TextAppearance.Livre.BodySmall" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">@dimen/text_size_body_small</item>
        <item name="android:textColor">?attr/livreColorTextSecondary</item>
    </style>

    <!-- Body: standard reading text in lists, cards, dialogs -->
    <style name="TextAppearance.Livre.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:textColor">?attr/livreColorTextPrimary</item>
    </style>

    <!-- Body Large: emphasized body text, reader settings values -->
    <style name="TextAppearance.Livre.BodyLarge" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">@dimen/text_size_body_large</item>
        <item name="android:textColor">?attr/livreColorTextPrimary</item>
    </style>

    <!-- Title: screen titles, card headers, dialog titles -->
    <style name="TextAppearance.Livre.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">@dimen/text_size_title</item>
        <item name="android:textColor">?attr/livreColorTextPrimary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Title Large: book titles, hero headers -->
    <style name="TextAppearance.Livre.TitleLarge" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textSize">@dimen/text_size_title_large</item>
        <item name="android:textColor">?attr/livreColorTextPrimary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Headline: largest text, book details title -->
    <style name="TextAppearance.Livre.Headline" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:textSize">@dimen/text_size_headline</item>
        <item name="android:textColor">?attr/livreColorTextPrimary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ============================================================
         READER-SPECIFIC TYPOGRAPHY
         Uses reader chrome text colors (always white on dark chrome)
      -->
    <style name="TextAppearance.Livre.ReaderChrome" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:textColor">@color/colorReaderChromeText</item>
    </style>

    <style name="TextAppearance.Livre.ReaderChromeSecondary" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">@dimen/text_size_body_small</item>
        <item name="android:textColor">@color/colorReaderChromeTextSecondary</item>
    </style>

    <style name="TextAppearance.Livre.ReaderChromeTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">@dimen/text_size_title</item>
        <item name="android:textColor">@color/colorReaderChromeText</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
