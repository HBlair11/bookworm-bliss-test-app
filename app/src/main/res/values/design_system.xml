<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      ============================================================
      LIVRE MAGICAE — SEMANTIC DESIGN SYSTEM
      ============================================================
      This file is the SINGLE SOURCE OF TRUTH for every semantic
      design token in the app. Individual screens and components
      reference these names — never raw hex colors, never hardcoded
      dp/sp values, and never ad-hoc resource names.

      Layering model:
        Brand Palette (colors.xml)
            ↓
        Semantic Tokens (THIS FILE)
            ↓
        Theme (themes.xml)
            ↓
        Components & Screens (layouts)

      To change the app's visual identity, edit the semantic tokens
      here. To change a specific theme, edit themes.xml. Screens
      never invent their own values.

      ============================================================
      COLOR TOKENS
      ============================================================
      Each semantic color maps to a palette color from colors.xml.
      The palette has 5 brand colors; these semantic names give
      them meaning. Day/night variations are handled by providing
      both light_ and dark_ variants, with the theme selecting
      the appropriate one.

      Naming convention:
        color_<role>[_variant]
      Where <role> is: primary, secondary, background, surface,
      text, divider, accent, error, success, disabled, etc.
    -->

    <!-- ===== Primary / Brand ===== -->
    <color name="colorPrimary">@color/palette_plum</color>
    <color name="colorPrimaryVariant">@color/palette_purple</color>
    <color name="colorOnPrimary">@color/white</color>
    <color name="colorSecondary">@color/palette_slate</color>
    <color name="colorOnSecondary">@color/white</color>

    <!-- ===== Background & Surfaces ===== -->
    <color name="colorBackground">@color/light_bg</color>
    <color name="colorSurface">@color/light_surface</color>
    <color name="colorSurfaceVariant">@color/light_surface_alt</color>
    <color name="colorOnBackground">@color/light_text</color>
    <color name="colorOnSurface">@color/light_text</color>

    <!-- ===== Text Hierarchy ===== -->
    <color name="colorTextPrimary">@color/light_text</color>
    <color name="colorTextSecondary">@color/light_text_muted</color>
    <color name="colorTextTertiary">@color/light_text_faint</color>

    <!-- ===== Structural ===== -->
    <color name="colorDivider">@color/light_border</color>
    <color name="colorAccent">@color/palette_mint</color>
    <color name="colorError">@color/palette_eggplant</color>
    <color name="colorSuccess">@color/palette_mint</color>
    <color name="colorDisabled">@color/palette_slate</color>

    <!-- ===== Reader Content Area ===== -->
    <color name="colorReaderBackground">@color/reader_bg_light</color>
    <color name="colorReaderText">@color/reader_ink_light</color>
    <color name="colorReaderLink">@color/palette_purple</color>
    <color name="colorReaderSelection">@color/tts_word_highlight</color>

    <!-- ===== Reader Chrome (static dark surface) ===== -->
    <color name="colorReaderChromeBackground">@color/reader_chrome_bg</color>
    <color name="colorReaderChromeSurface">@color/reader_chrome_surface</color>
    <color name="colorReaderChromeText">@color/reader_chrome_text</color>
    <color name="colorReaderChromeTextSecondary">@color/reader_chrome_text_muted</color>
    <color name="colorReaderChromeAccent">@color/reader_chrome_accent</color>
    <color name="colorReaderChromeScrim">@color/reader_chrome_scrim</color>

    <!-- ============================================================
         DIMENSION TOKENS — SPACING SCALE
         ============================================================
         A consistent 4dp-based spacing scale. Every layout references
         these names instead of hardcoding dp values.

         xs=4  sm=8  md=12  lg=16  xl=24  xxl=32
      -->
    <dimen name="spacing_xs">4dp</dimen>
    <dimen name="spacing_sm">8dp</dimen>
    <dimen name="spacing_md">12dp</dimen>
    <dimen name="spacing_lg">16dp</dimen>
    <dimen name="spacing_xl">24dp</dimen>
    <dimen name="spacing_xxl">32dp</dimen>

    <!-- ===== Screen-level padding ===== -->
    <dimen name="screen_padding_h">@dimen/spacing_lg</dimen>
    <dimen name="screen_padding_v">@dimen/spacing_lg</dimen>

    <!-- ===== Card padding ===== -->
    <dimen name="card_padding">@dimen/spacing_lg</dimen>
    <dimen name="card_padding_h">@dimen/spacing_lg</dimen>
    <dimen name="card_padding_v">@dimen/spacing_md</dimen>

    <!-- ===== Row spacing ===== -->
    <dimen name="row_spacing">@dimen/spacing_sm</dimen>
    <dimen name="row_padding_h">@dimen/spacing_md</dimen>
    <dimen name="row_padding_v">@dimen/spacing_sm</dimen>

    <!-- ===== Content padding inside list rows ===== -->
    <dimen name="row_content_padding_h">20dp</dimen>

    <!-- ===== Section spacing ===== -->
    <dimen name="section_spacing">@dimen/spacing_lg</dimen>
    <dimen name="card_spacing">@dimen/spacing_md</dimen>

    <!-- ============================================================
         DIMENSION TOKENS — COMPONENT SIZES
         ============================================================
      -->
    <!-- Touch targets -->
    <dimen name="touch_target">48dp</dimen>
    <dimen name="icon_button_size">44dp</dimen>
    <dimen name="icon_small">16dp</dimen>
    <dimen name="icon_medium">24dp</dimen>
    <dimen name="icon_large">32dp</dimen>

    <!-- Toolbar / Chrome -->
    <dimen name="toolbar_height">56dp</dimen>
    <dimen name="button_height">48dp</dimen>
    <dimen name="chrome_padding_v">6dp</dimen>
    <dimen name="chrome_padding_h">10dp</dimen>

    <!-- Selection toolbar -->
    <dimen name="selection_toolbar_height">56dp</dimen>
    <dimen name="selection_toolbar_padding">8dp</dimen>
    <dimen name="selection_toolbar_estimated_width">360dp</dimen>
    <dimen name="selection_toolbar_action_padding_h">16dp</dimen>
    <dimen name="selection_toolbar_action_min_width">48dp</dimen>
    <dimen name="selection_toolbar_action_margin_h">2dp</dimen>
    <dimen name="selection_toolbar_text_size">14sp</dimen>

    <!-- Grid / Book covers -->
    <dimen name="grid_edge_h">10dp</dimen>
    <dimen name="text_row_padding_h">6dp</dimen>

    <!-- Definition popup -->
    <dimen name="definition_card_max_width">320dp</dimen>
    <dimen name="definition_card_elevation">8dp</dimen>
    <dimen name="popup_screen_margin">12dp</dimen>
    <dimen name="definition_row_spacing">8dp</dimen>

    <!-- ============================================================
         DIMENSION TOKENS — CORNER RADII (SHAPES)
         ============================================================
      -->
    <dimen name="card_corner_radius">14dp</dimen>
    <dimen name="button_corner_radius">12dp</dimen>
    <dimen name="dialog_corner_radius">16dp</dimen>
    <dimen name="chip_corner_radius">8dp</dimen>
    <dimen name="thumbnail_corner_radius">6dp</dimen>

    <!-- ============================================================
         DIMENSION TOKENS — ELEVATIONS
         ============================================================
      -->
    <dimen name="card_elevation">2dp</dimen>
    <dimen name="card_elevation_raised">6dp</dimen>
    <dimen name="dialog_elevation">8dp</dimen>
    <dimen name="toolbar_elevation">4dp</dimen>
    <dimen name="fab_elevation">6dp</dimen>
    <dimen name="popup_elevation">8dp</dimen>

    <!-- ============================================================
         DIMENSION TOKENS — TYPOGRAPHY SIZES
         ============================================================
         The app uses a compact type scale optimized for reading apps.
         sp values are referenced by TextAppearance styles below.
      -->
    <dimen name="text_size_caption">11sp</dimen>
    <dimen name="text_size_overline">12sp</dimen>
    <dimen name="text_size_body_small">13sp</dimen>
    <dimen name="text_size_body">14sp</dimen>
    <dimen name="text_size_body_large">16sp</dimen>
    <dimen name="text_size_title">18sp</dimen>
    <dimen name="text_size_title_large">22sp</dimen>
    <dimen name="text_size_headline">26sp</dimen>
</resources>
