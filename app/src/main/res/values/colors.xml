<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Android requires a couple of colors to exist as XML resources for
        things Compose doesn't own yet (the pre-draw window background /
        splash flash). These are mirrored from BookwormPalette in Color.kt —
        if you change the palette there, update these two lines to match.
        Everything else in the app reads colors from Color.kt, not from here.
    -->
    <color name="window_background">#FFFFEEF2</color>
    <color name="window_background_dark">#FF211A1E</color>
</resources>
