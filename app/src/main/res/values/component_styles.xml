<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      ============================================================
      COMPONENT STYLES — REUSABLE UI BUILDING BLOCKS
      ============================================================
      These are the app's reusable component styles. Every screen
      references these instead of re-declaring the same properties.

      They consume the semantic tokens (colors, dimensions, shapes)
      from design_system.xml, so changing a token here changes every
      instance app-wide.

      NOTE: Custom attributes use the `livre` prefix to avoid
      collisions with Material Components / AppCompat attrs.
    -->

    <!-- ============================================================
         CARDS
         ============================================================
    -->

    <!-- Standard Material card: book cards, metadata rows -->
    <style name="Widget.Livre.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="contentPadding">@dimen/card_padding</item>
    </style>

    <!-- Flat card (no elevation) for lists -->
    <style name="Widget.Livre.CardView.Flat" parent="Widget.Livre.CardView">
        <item name="cardElevation">0dp</item>
    </style>

    <!-- ============================================================
         BUTTONS
         ============================================================
    -->

    <!-- Primary action button -->
    <style name="Widget.Livre.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
    </style>

    <!-- Outlined/secondary button -->
    <style name="Widget.Livre.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
    </style>

    <!-- Text button (tertiary action) -->
    <style name="Widget.Livre.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:minHeight">@dimen/touch_target</item>
    </style>

    <!-- Icon-only button (toolbars, chrome) -->
    <style name="Widget.Livre.Button.Icon" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:layout_width">@dimen/icon_button_size</item>
        <item name="android:layout_height">@dimen/icon_button_size</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingRight">0dp</item>
        <item name="iconPadding">0dp</item>
        <item name="iconTint">?attr/colorPrimary</item>
        <item name="rippleColor">?attr/colorPrimary</item>
    </style>

    <!-- Reader chrome icon button (always white on dark) -->
    <style name="Widget.Livre.Button.Icon.ReaderChrome" parent="Widget.Livre.Button.Icon">
        <item name="iconTint">@color/colorReaderChromeText</item>
        <item name="rippleColor">@color/colorReaderChromeText</item>
    </style>

    <!-- ============================================================
         TEXT VIEWS
         ============================================================
    -->

    <!-- Base parent style (required for dot-notation children) -->
    <style name="Widget.Livre.TextView" />

    <!-- Screen title -->
    <style name="Widget.Livre.TextView.ScreenTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/TextAppearance.Livre.TitleLarge</item>
        <item name="android:padding">@dimen/screen_padding_h</item>
    </style>

    <!-- Section header -->
    <style name="Widget.Livre.TextView.SectionHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/TextAppearance.Livre.Overline</item>
        <item name="android:paddingStart">@dimen/screen_padding_h</item>
        <item name="android:paddingEnd">@dimen/screen_padding_h</item>
        <item name="android:paddingTop">@dimen/spacing_sm</item>
        <item name="android:paddingBottom">@dimen/spacing_sm</item>
    </style>

    <!-- Body text -->
    <style name="Widget.Livre.TextView.Body">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/TextAppearance.Livre.Body</item>
    </style>

    <!-- Caption / metadata text -->
    <style name="Widget.Livre.TextView.Caption">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/TextAppearance.Livre.Caption</item>
    </style>

    <!-- ============================================================
         CONTAINERS
         ============================================================
    -->

    <!-- Base parent style (required for dot-notation children) -->
    <style name="Widget.Livre.Container" />

    <!-- Screen root container with standard padding -->
    <style name="Widget.Livre.Container.Screen">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:paddingStart">@dimen/screen_padding_h</item>
        <item name="android:paddingEnd">@dimen/screen_padding_h</item>
        <item name="android:paddingTop">@dimen/screen_padding_v</item>
        <item name="android:paddingBottom">@dimen/screen_padding_v</item>
    </style>

    <!-- Card container -->
    <style name="Widget.Livre.Container.Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:padding">@dimen/card_padding</item>
        <item name="android:background">@drawable/surface_card_bg</item>
    </style>

    <!-- Row container -->
    <style name="Widget.Livre.Container.Row">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:paddingStart">@dimen/row_content_padding_h</item>
        <item name="android:paddingEnd">@dimen/row_content_padding_h</item>
        <item name="android:paddingTop">@dimen/row_padding_v</item>
        <item name="android:paddingBottom">@dimen/row_padding_v</item>
    </style>
</resources>
