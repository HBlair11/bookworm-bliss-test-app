<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      ============================================================
      CUSTOM THEME ATTRIBUTES — SEMANTIC UI TOKENS
      ============================================================
      These attributes let layouts reference semantic design tokens
      via ?attr/livreColorTextPrimary, ?attr/livreSpacingCard, etc.

      IMPORTANT: All custom attributes use the `livre` prefix to avoid
      collisions with Material Components / AppCompat attrs that already
      define colorAccent, colorError, colorSurfaceVariant, etc.

      The actual values are assigned per-theme in themes.xml.
      This is what enables runtime theme switching: each theme
      (Original, Pastel) assigns different
      values to the same attribute names.

      Usage in layouts:
        android:textColor="?attr/livreColorTextPrimary"
        android:padding="?attr/livreSpacingCard"
        android:background="?attr/livreColorSurface"
    -->

    <!-- ===== Color attributes ===== -->
    <attr name="livreColorTextPrimary" format="color" />
    <attr name="livreColorTextSecondary" format="color" />
    <attr name="livreColorTextTertiary" format="color" />
    <attr name="livreColorSurfaceVariant" format="color" />
    <attr name="livreColorDivider" format="color" />
    <attr name="livreColorAccent" format="color" />
    <attr name="livreColorError" format="color" />
    <attr name="livreColorSuccess" format="color" />
    <attr name="livreColorDisabled" format="color" />

    <!-- Reader content area -->
    <attr name="livreColorReaderBackground" format="color" />
    <attr name="livreColorReaderText" format="color" />
    <attr name="livreColorReaderLink" format="color" />
    <attr name="livreColorReaderSelection" format="color" />

    <!-- Reader chrome -->
    <attr name="livreColorReaderChromeBackground" format="color" />
    <attr name="livreColorReaderChromeSurface" format="color" />
    <attr name="livreColorReaderChromeText" format="color" />
    <attr name="livreColorReaderChromeTextSecondary" format="color" />
    <attr name="livreColorReaderChromeAccent" format="color" />
    <attr name="livreColorReaderChromeScrim" format="color" />

    <!-- ===== Dimension attributes ===== -->
    <attr name="livreScreenPadding" format="dimension" />
    <attr name="livreCardPadding" format="dimension" />
    <attr name="livreRowSpacing" format="dimension" />
    <attr name="livreCardSpacing" format="dimension" />
    <attr name="livreSectionSpacing" format="dimension" />

    <!-- ===== Shape attributes ===== -->
    <attr name="livreShapeCard" format="reference" />
    <attr name="livreShapeButton" format="reference" />
    <attr name="livreShapeDialog" format="reference" />
    <attr name="livreShapeChip" format="reference" />
    <attr name="livreShapeThumbnail" format="reference" />
</resources>
